{
  /* 主进程 / 预加载的 TS 类型检查配置：面向 Electron 的 Node 环境，不引入 DOM */
  "compilerOptions": {
    "composite": true,                     /* 供 tsconfig.json 项目引用 */
    "target": "ES2022",                    /* 主进程/预加载运行于 Electron 的 Node 环境 */
    "module": "ESNext",
    "moduleResolution": "Bundler",         /* 由 electron-vite(Vite/Rollup) 打包解析 */
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"], /* 仅注入 Node 与 electron-vite 类型，不引入 DOM */
    "strict": true,
    "noEmit": true,                        /* 仅做类型检查，产物由 electron-vite 生成 */
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@main/*": ["./src/main/*"],         /* 主进程入口壳 */
      "@preload/*": ["./src/preload/*"],   /* 预加载入口壳 */
      "@common/*": ["./src/common/*"],     /* 跨域公共 */
      "@modules/*": ["./src/modules/*"]    /* 领域模块 */
    }
  },
  "include": [
    "src/main/**/*",                       /* 主进程入口壳 */
    "src/preload/**/*",                    /* 预加载入口壳 */
    "src/common/shared/**/*",              /* 跨进程公共 */
    "src/common/main/**/*",                /* 主进程公共基础设施 */
    "src/modules/*/shared/**/*",           /* 领域契约 */
    "src/modules/*/main/**/*",             /* 领域主进程实现 */
    "src/modules/*/preload/**/*",          /* 领域预加载片段 */
    "src/modules/*/worker/**/*",           /* 领域 Worker 实现 */
    "electron.vite.config.ts"              /* 构建配置本身也纳入检查 */
  ]
}
