{
  "name": "xxl-ai-desk",
  "version": "1.5.0-SNAPSHOT",
  "private": true,
  "description": "XXL-AI-Desk | AI Agent 桌面客户端",
  "homepage": "https://github.com/xuxueli/xxl-ai",
  "author": "xuxueli",
  "license": "GPL",
  "main": "./out/main/index.js",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run type-check && electron-vite build",
    "type-check": "npm run type-check:node && npm run type-check:web",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "type-check:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "pack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:win": "npm run build && electron-builder --win --x64 --config.npmRebuild=false",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "adm-zip": "0.6.1",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "electron-log": "5.4.4",
    "node-pty": "1.1.0",
    "tar": "7.5.22",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@element-plus/icons-vue": "2.3.2",
    "@lezer/highlight": "1.2.5",
    "@mdit/plugin-katex": "1.1.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "element-plus": "2.14.8",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "pinia": "4.1.0",
    "sass-embedded": "1.108.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.14"
  }
}
