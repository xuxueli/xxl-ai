{
  /* 渲染进程（Web）的 TS 类型检查配置：面向浏览器 DOM 环境 + Vue/JSX */
  "compilerOptions": {
    "composite": true,                     /* 供 tsconfig.json 项目引用 */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",         /* 由 Vite 打包解析 */
    "lib": ["ES2023", "DOM", "DOM.Iterable"], /* 渲染进程运行于浏览器环境 */
    "jsx": "preserve",
    "types": ["vite/client"],              /* 注入 Vite 客户端类型（import.meta.env 等） */
    "strict": true,
    "noEmit": true,                        /* 仅做类型检查，产物由 Vite 生成 */
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"], /* 渲染进程入口壳 */
      "@common/*": ["./src/common/*"],         /* 跨域公共 */
      "@modules/*": ["./src/modules/*"],       /* 领域模块 */
      "@resources/*": ["./resources/*"],       /* 项目级静态资源（图标等） */
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",               /* 渲染进程外壳 */
    "src/renderer/src/**/*.vue",           /* Vue 单文件组件 */
    "src/preload/*.d.ts",                  /* window.desk 类型声明 */
    "src/preload/deskApi.ts",              /* DeskApi 聚合类型 */
    "src/common/shared/**/*",              /* 跨进程公共 */
    "src/common/renderer/**/*",            /* 渲染进程公共 */
    "src/modules/*/shared/**/*",           /* 领域契约 */
    "src/modules/*/renderer/**/*"          /* 领域渲染实现 */
  ]
}
