  "author": "xuxueli",
  "license": "GPL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run type-check",
    "build": "vite build",
    "prebuild:stage": "npm run type-check",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "type-check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueup/vue-quill": "1.5.5",
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "clipboard": "2.0.11",
    "dompurify": "3.4.16",
    "echarts": "6.1.0",
    "element-plus": "2.14.6",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "js-beautify": "2.0.3",
    "js-cookie": "3.0.8",
    "marked": "18.0.14",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/js-beautify": "1.14.3",
