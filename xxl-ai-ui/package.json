    "@types/nprogress": "0.2.3",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "fast-glob": "3.3.3",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "sass-embedded": "1.104.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "quill": "2.0.3"
