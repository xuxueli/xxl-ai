{
  "name": "XXL-AI",
  "version": "1.5.0-SNAPSHOT",
  "private": true,
  "description": "XXL-AI | AI应用开发平台",
  "repository": "git@github.com:xuxueli/xxl-ai.git",
  "author": "xuxueli",
  "license": "GPL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run type-check",
    "build": "vite build",
    "sync:dist": "node scripts/sync-dist.mjs",
    "prebuild:stage": "npm run type-check",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "type-check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueup/vue-quill": "1.5.5",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.0",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "element-plus": "2.14.8",
    "file-saver": "2.0.5",
    "highlight.js": "11.12.0",
    "hls.js": "1.7.4",
    "js-cookie": "3.0.8",
    "katex": "0.18.11",
    "marked": "18.1.3",
    "marked-katex-extension": "5.1.13",
    "nprogress": "0.2.0",
    "pinia": "4.1.0",
    "sortablejs": "1.15.7",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/js-cookie": "3.0.6",
    "@types/node": "26.6.6",
    "@types/nprogress": "0.2.3",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "fast-glob": "3.3.3",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.108.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "quill": "2.0.3"
  }
}
