# docker-compose env

# xxl-ai, api
XXL_AI_API_PORT=8090

# xxl-ai, sample-mcp
XXL_AI_SAMPLE_MCP_PORT=8091

# xxl-ai, ui
XXL_AI_UI_PORT=3000

# xxl-ai, database
MYSQL_ROOT_PASSWORD=root_pwd
MYSQL_PATH=/Users/admin/program/docker/instance/mysql

# xxl-ai, redis
REDIS_PASSWORD=
REDIS_PATH=/Users/admin/program/docker/instance/redis

# xxl-ai, milvus
MILVUS_PATH=/Users/admin/program/docker/instance/milvus